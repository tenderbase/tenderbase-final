generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OcdsRelease {
  id             String   @id
  ocid           String
  date           DateTime?
  tag            String[]
  initiationType  String?
  language       String?
  raw            Json
  ingestedAt     DateTime @default(now())
  tender         Tender?
  buyer          Party?   @relation("ReleaseBuyer", fields: [buyerId], references: [id])
  buyerId        String?
  links          Json?

  @@index([ocid])
  @@index([date])
  @@index([buyerId])
  @@index([ingestedAt])
}

model Tender {
  id                 String       @id @default(cuid())
  ocid               String       @unique
  releaseId          String       @unique
  title              String?
  description        String?
  status             String?
  procurementMethod  String?
  procurementMethodDetails String?
  mainProcurementCategory String?
  publishedDate      DateTime?
  closingDate        DateTime?
  valueAmount        Decimal?     @db.Decimal(18, 2)
  valueCurrency      String?
  raw                Json
  release            OcdsRelease  @relation(fields: [releaseId], references: [id])
  items              TenderItem[]
  documents          Document[]
  awards             Award[]
  contracts          Contract[]

  @@index([publishedDate])
  @@index([closingDate])
  @@index([status])
  @@index([procurementMethod])
  @@index([mainProcurementCategory])
}

model Party {
  id          String   @id @default(cuid())
  ocdsId      String?  @unique
  name        String
  identifier  String?
  partyType   String?
  address     Json?
  contactPoint Json?
  raw         Json
  buyerReleases OcdsRelease[] @relation("ReleaseBuyer")
  roles       PartyRole[]

  @@index([name])
  @@index([identifier])
}

model PartyRole {
  id       String @id @default(cuid())
  partyId  String
  role     String
  party    Party  @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, role])
  @@index([role])
}

model TenderItem {
  id             String   @id @default(cuid())
  tenderId       String
  itemId         String?
  description    String?
  quantity       Decimal? @db.Decimal(18, 4)
  unit           String?
  classification Json?
  deliveryAddress Json?
  tender         Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model Document {
  id        String  @id @default(cuid())
  tenderId  String
  documentId String?
  documentType String?
  title     String?
  format    String?
  url       String?
  datePublished DateTime?
  tender    Tender  @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([documentType])
}

model Award {
  id            String   @id @default(cuid())
  tenderId      String
  awardId       String?
  status        String?
  title         String?
  description   String?
  date          DateTime?
  valueAmount   Decimal? @db.Decimal(18, 2)
  valueCurrency String?
  suppliers     Json?
  raw           Json
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  contracts     Contract[]

  @@index([tenderId])
  @@index([date])
}

model Contract {
  id            String   @id @default(cuid())
  tenderId      String
  awardId       String?
  contractId    String?
  title         String?
  period        Json?
  valueAmount   Decimal? @db.Decimal(18, 2)
  valueCurrency String?
  raw           Json
  tender        Tender   @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  award         Award?   @relation(fields: [awardId], references: [id])

  @@index([tenderId])
  @@index([awardId])
}

model IngestionRun {
  id          String   @id @default(cuid())
  source      String
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  dateFrom    DateTime?
  dateTo      DateTime?
  pages       Int      @default(0)
  releases    Int      @default(0)
  succeeded   Int      @default(0)
  failed      Int      @default(0)
  status      String   @default("running")
  error       String?
  metadata    Json?

  @@index([startedAt])
  @@index([status])
}

model IngestionError {
  id            String   @id @default(cuid())
  ingestionRunId String?
  occurredAt    DateTime @default(now())
  endpoint      String?
  page          Int?
  releaseId     String?
  message       String
  payload       Json?

  @@index([ingestionRunId])
  @@index([occurredAt])
}
