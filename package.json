{
  "name": "tenderbase-api",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma db push && node scripts/harden-api.mjs && tsc && cp src/fastify-hardening.cjs dist/fastify-hardening.cjs",
    "start": "node -r ./dist/fastify-hardening.cjs dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "ingest:30d": "tsx src/jobs/etenders-sync.ts --days=30",
    "ingest:hourly": "tsx src/jobs/etenders-sync.ts --hours=2",
    "ingest:web-smoke": "tsx src/jobs/etenders-web-ingest-smoke.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "fastify": "^5.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.2",
    "prisma": "^6.19.3",
    "tsx": "^4.20.5",
    "test": "node --test"
  }
}
